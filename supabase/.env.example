# Copy to `supabase/.env` and fill in. NEVER commit the real .env.
# The Supabase CLI reads this automatically for `env(...)` substitution in config.toml.
#
# ---------------------------------------------------------------------------
# Google OAuth — the university-email signup path
# ---------------------------------------------------------------------------
# Obtain from https://console.cloud.google.com/apis/credentials
#   Create credentials -> OAuth client ID -> Application type: "Web application"
#
# Authorized redirect URIs must include, exactly:
#   http://127.0.0.1:54321/auth/v1/callback          (local dev)
#   https://<project-ref>.supabase.co/auth/v1/callback   (hosted, once linked)
#
# Scopes needed: openid, email, profile. Nothing more — we only ever read the
# address, and only to parse a registration number out of it.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# ---------------------------------------------------------------------------
# Apple OAuth — only needed if/when shipping iOS
# ---------------------------------------------------------------------------
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=

# ---------------------------------------------------------------------------
# Axene Mailer — transactional email for R.5 (recovery-email delivery)
# ---------------------------------------------------------------------------
# Obtain from https://mail.axene.io -> Settings -> API Keys. Free tier covers
# local dev and early testing (3,000 sends/month).
#
# AXENE_SENDER_EMAIL must be a sender address on a domain verified in Axene
# (Settings -> Domains -> SPF/DKIM/DMARC wizard) — sends from an unverified
# domain are rejected.
#
# Wired through to Edge Functions via [edge_runtime.secrets] in config.toml;
# read there with Deno.env.get(...), never hardcoded in function source.
#
# Left unset, functions/_shared/axene.ts falls back to logging the email
# payload to the function console instead of sending — safe default for local
# dev with no key configured.
AXENE_API_KEY=
AXENE_SENDER_EMAIL=
AXENE_SENDER_NAME=

# ---------------------------------------------------------------------------
# Firebase Cloud Messaging — push delivery for 3.1
# ---------------------------------------------------------------------------
# Firebase console -> Project settings -> Service accounts -> "Generate new
# private key". NOT google-services.json (that's the Android client config,
# no private key, can't authenticate server-side sends) — this is the FCM
# HTTP v1 API's service-account OAuth credential.
#
# Paste the ENTIRE downloaded JSON file, base64-encoded onto one line, e.g.:
#   base64 -w0 /path/to/service-account.json
#
# Wired through to Edge Functions via [edge_runtime.secrets] in config.toml;
# read there with Deno.env.get(...) in functions/_shared/fcm.ts, never
# hardcoded in function source.
#
# Left unset, functions/_shared/fcm.ts falls back to logging the push
# payload to the function console instead of sending — safe default for
# local dev with no Firebase project configured.
FCM_SERVICE_ACCOUNT=
